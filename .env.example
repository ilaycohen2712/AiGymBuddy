WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Empty for now — Meta business account is pending verification (~4 day ETA).
# Fill in once the account unlocks and a real test/production number exists.
WHATSAPP_ACCESS_TOKEN=
# Empty for now — same reason as WHATSAPP_ACCESS_TOKEN above.
WHATSAPP_PHONE_NUMBER_ID=
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/aigymbuddy
# Shared secret an external scheduler must send (X-Scheduler-Secret header)
# to POST /internal/eod-trigger. Empty always rejects the trigger.
SCHEDULER_SECRET=
# Name of the Meta-approved WhatsApp template for a proactive send outside
# the 24h window (see app/whatsapp/templates.py). Empty until one is
# registered and approved in Meta Business Manager.
EOD_TEMPLATE_NAME=
# Fixed local hour (0-23) the end-of-day report/target-ask fires at.
EOD_REPORT_HOUR=21
